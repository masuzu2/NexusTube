<?xml version="1.0" encoding="UTF-8"?>
<!--
  NexusTube.wxs — WiX Toolset v3  (Win10/11 compatible)
  ======================================================
  Fixed:
  - ลบ Condition VersionNT >= 1000 (Win10 report 603 ถ้าไม่มี manifest)
  - ลบ Condition VersionNT64 (ไม่จำเป็นสำหรับ exe นี้)
  - แยก shortcuts เป็น component HKCU (ICE43/ICE57 compliant)
  - เพิ่ม WebView2 detection + warning
-->

<?define ProductName    = "NexusTube" ?>
<?define ProductVersion = "3.2.0" ?>
<?define Manufacturer   = "by herlove" ?>
<?define UpgradeCode    = "{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}" ?>
<?define HelpUrl        = "https://github.com/masuzu2/NexusTube" ?>
<?define UpdateUrl      = "https://github.com/masuzu2/NexusTube/releases" ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product
    Id="*"
    Name="$(var.ProductName)"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="$(var.Manufacturer)"
    UpgradeCode="$(var.UpgradeCode)">

    <Package
      Description="Next-Gen YouTube and Multi-Platform Music Suite"
      Comments="NexusTube v3.2.0 — by herlove"
      Manufacturer="$(var.Manufacturer)"
      InstallerVersion="301"
      Platform="x64"
      Compressed="yes"
      InstallScope="perMachine" />

    <!-- ── Upgrade: ลบเวอร์ชันเก่าก่อน ──────────────────────── -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of NexusTube is already installed. Please uninstall it first."
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ── Icon ────────────────────────────────────────────── -->
    <Icon Id="NexusTubeIcon.ico" SourceFile="NexusTube.ico" />

    <!-- ── Add/Remove Programs ──────────────────────────────── -->
    <Property Id="ARPPRODUCTICON"   Value="NexusTubeIcon.ico" />
    <Property Id="ARPHELPLINK"      Value="$(var.HelpUrl)" />
    <Property Id="ARPURLUPDATEINFO" Value="$(var.UpdateUrl)" />
    <Property Id="ARPNOREPAIR"      Value="1" />
    <Property Id="ARPSYSTEMCOMPONENT" Value="0" />

    <!--
      ====================================================
      NOTE: ไม่ใส่ Condition VersionNT >= 1000
      เพราะ Windows 10/11 ที่ไม่มี compatibility manifest
      จะ report VersionNT = 603 (Win8.1) ทำให้ fail
      ====================================================
    -->

    <!-- ── WebView2 detection (warn only, ไม่ block) ────────── -->
    <Property Id="WEBVIEW2_INSTALLED">
      <RegistrySearch Id="WebView2Search1"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv"
        Type="raw"
        Win64="yes" />
    </Property>
    <Property Id="WEBVIEW2_INSTALLED_32">
      <RegistrySearch Id="WebView2Search2"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv"
        Type="raw"
        Win64="no" />
    </Property>
    <Property Id="WEBVIEW2_USER">
      <RegistrySearch Id="WebView2Search3"
        Root="HKCU"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Name="pv"
        Type="raw" />
    </Property>

    <!-- ── Directories ──────────────────────────────────────── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="$(var.ProductName)" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- ── Component 1: Main EXE + HKLM registry ────────────── -->
    <DirectoryRef Id="INSTALLDIR">

      <Component Id="NexusTubeExeComp"
                 Guid="{B2C3D4E5-F6A7-8901-BCDE-F12345678901}"
                 Win64="yes">
        <File Id="NexusTubeExeFile"
              Name="NexusTube.exe"
              Source="NexusTube.exe"
              KeyPath="yes" />
        <RegistryValue
          Root="HKLM"
          Key="Software\$(var.Manufacturer)\$(var.ProductName)"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLDIR]" />
        <RegistryValue
          Root="HKLM"
          Key="Software\$(var.Manufacturer)\$(var.ProductName)"
          Name="Version"
          Type="string"
          Value="$(var.ProductVersion)" />
      </Component>

      <!-- Icon file -->
      <Component Id="IconComp"
                 Guid="{C3D4E5F6-A7B8-9012-CDEF-123456789012}"
                 Win64="yes">
        <File Id="NexusTubeIcoFile"
              Name="NexusTube.ico"
              Source="NexusTube.ico"
              KeyPath="yes" />
      </Component>

    </DirectoryRef>

    <!-- ── Component 2: Desktop shortcut (HKCU KeyPath) ─────── -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComp"
                 Guid="{E5F6A7B8-C9D0-1234-EF01-345678901234}"
                 Win64="yes">
        <RegistryValue
          Root="HKCU"
          Key="Software\$(var.Manufacturer)\$(var.ProductName)"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <Shortcut
          Id="DesktopShortcut"
          Directory="DesktopFolder"
          Name="$(var.ProductName)"
          Description="Next-Gen YouTube Downloader and Music Player"
          Target="[#NexusTubeExeFile]"
          WorkingDirectory="INSTALLDIR"
          Icon="NexusTubeIcon.ico" />
      </Component>
    </DirectoryRef>

    <!-- ── Component 3: Start Menu (HKCU KeyPath) ───────────── -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuComp"
                 Guid="{D4E5F6A7-B8C9-0123-DEF0-234567890123}"
                 Win64="yes">
        <RegistryValue
          Root="HKCU"
          Key="Software\$(var.Manufacturer)\$(var.ProductName)"
          Name="StartMenu"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <Shortcut
          Id="StartMenuShortcut"
          Directory="ApplicationProgramsFolder"
          Name="$(var.ProductName)"
          Description="Next-Gen YouTube Downloader and Music Player"
          Target="[#NexusTubeExeFile]"
          WorkingDirectory="INSTALLDIR"
          Icon="NexusTubeIcon.ico" />
        <Shortcut
          Id="UninstallShortcut"
          Directory="ApplicationProgramsFolder"
          Name="Uninstall NexusTube"
          Description="Remove NexusTube from this computer"
          Target="[SystemFolder]msiexec.exe"
          Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveStartMenuFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- ── Features ─────────────────────────────────────────── -->
    <Feature
      Id="ProductFeature"
      Title="$(var.ProductName)"
      Description="NexusTube — Next-Gen YouTube and Music Suite"
      Level="1"
      Absent="disallow"
      AllowAdvertise="no">
      <ComponentRef Id="NexusTubeExeComp" />
      <ComponentRef Id="IconComp" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuComp" />
    </Feature>

    <!-- ── UI ───────────────────────────────────────────────── -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIDialogBmp"  Value="WixUIDialog.bmp" />
    <WixVariable Id="WixUIBannerBmp"  Value="WixUIBanner.bmp" />

    <!-- ── Launch after install ─────────────────────────────── -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NexusTube now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX"     Value="1" />

    <CustomAction Id="LaunchApplication"
                  FileKey="NexusTubeExeFile"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize">
        <![CDATA[WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed]]>
      </Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
